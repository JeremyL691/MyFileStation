{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyFileStation",
  "version": "0.3.0",
  "identifier": "com.myfilestation.desktop",
  "build": {
    "beforeDevCommand": "pnpm --dir frontend dev:web",
    "devUrl": "http://127.0.0.1:1430",
    "beforeBuildCommand": "pnpm --dir frontend build:web",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "MyFileStation",
        "width": 420,
        "height": 720,
        "minWidth": 360,
        "minHeight": 440,
        "resizable": false,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "dragDropEnabled": true,
        "devtools": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png", "icons/32x32.png", "icons/128x128.png"],
    "resources": { "icons/drag-icon.png": "resources/drag-icon.png" },
    "category": "Utility",
    "shortDescription": "A quiet place to hold files between apps.",
    "longDescription": "A lightweight file shelf that makes it easy to carry files between the apps you use.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      },
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
