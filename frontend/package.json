{
  "name": "@myfilestation/frontend",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "cd .. && frontend\\node_modules\\.bin\\tauri.cmd dev --config src-tauri\\tauri.conf.json",
