    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "radix-ui": "^1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^2.5.4",
    "tw-animate-css": "^1.4.0"
